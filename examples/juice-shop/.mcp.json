{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.85",
        "--isolated",
        "--headless",
        "--allowed-origins",
        "http://localhost:3000",
        "--image-responses",
        "omit",
        "--output-dir",
        ".playwright-output",
        "--storage-state",
        ".reconqa/auth/state.json"
      ]
    }
  }
}
